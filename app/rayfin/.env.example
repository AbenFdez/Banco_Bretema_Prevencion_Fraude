# Copia este archivo como rayfin/.env y rellena los dos identificadores.
# Los ves en la URL del Lakehouse en el portal de Fabric:
#   https://app.fabric.microsoft.com/groups/<BRETEMA_WORKSPACE_ID>/lakehouses/<BRETEMA_LAKEHOUSE_ID>
# La CLI de Rayfin añadirá más variables a rayfin/.env al desplegar; no las borres.
BRETEMA_WORKSPACE_ID=
BRETEMA_LAKEHOUSE_ID=
