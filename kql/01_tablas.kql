// ============================================================================
// Banco Brétema · 01 · Tablas del Eventhouse
//
// Dónde: Eventhouse Bretema_EH › base de datos KQL Bretema_EH › Explorar los datos
//        (o un conjunto de consultas KQL conectado a esa base de datos).
// Cómo:  ejecuta cada comando por separado: coloca el cursor en él y pulsa Ejecutar.
//
// Crear las tablas antes de cargar los CSV fija los tipos de cada columna. Si
// dejas que el asistente «Get data» las cree, puede convertir columnas de
// texto en números o fechas sin hora.
//
// Los números enteros van como long, no como int: el asistente lee los enteros
// de un CSV como long y, si la columna de la tabla es int, no la rellena: crea
// otra columna con el sufijo _1 (edad_1) y deja la original vacía.
// ============================================================================

// Operaciones con tarjeta: histórico (CSV) y tiempo real (Eventstream)
.create-merge table transacciones (
    transaccion_id: string,
    tarjeta_id: string,
    comercio_id: string,
    fecha_hora: datetime,
    importe_eur: real,
    canal: string,
    pais: string,
    resultado: string
) with (folder = "Banco", docstring = "Operaciones con tarjeta. Las de tiempo real tienen transaccion_id con prefijo TX-RT-")

// Alertas del motor antifraude (histórico)
.create-merge table alertas (
    alerta_id: string,
    transaccion_id: string,
    tarjeta_id: string,
    cliente_id: string,
    fecha_hora: datetime,
    tipo_alerta: string,
    motivo: string,
    puntuacion_riesgo: long,
    prioridad: string,
    estado: string,
    resolucion: string,
    fecha_resolucion: datetime
) with (folder = "Banco", docstring = "Alertas históricas del motor antifraude, abiertas o cerradas con su resolución")

// Tablas de referencia para cruzar en KQL (las mismas que van al Lakehouse)
.create-merge table comercios (
    comercio_id: string,
    nombre: string,
    categoria: string,
    municipio: string,
    pais: string,
    canal: string,
    nivel_riesgo: string,
    latitud: real,
    longitud: real
) with (folder = "Referencia")

.create-merge table tarjetas (
    tarjeta_id: string,
    cuenta_id: string,
    cliente_id: string,
    tipo_tarjeta: string,
    tarjeta_enmascarada: string,
    fecha_emision: datetime,
    fecha_caducidad: datetime,
    limite_eur: real,
    estado: string,
    fecha_bloqueo: datetime
) with (folder = "Referencia")

.create-merge table clientes (
    cliente_id: string,
    nombre: string,
    tipo_cliente: string,
    segmento: string,
    edad: long,
    municipio: string,
    provincia: string,
    fecha_alta: datetime,
    oficina_id: string,
    gestor_id: string,
    riesgo_kyc: string
) with (folder = "Referencia")

.create-merge table oficinas (
    oficina_id: string,
    nombre: string,
    municipio: string,
    provincia: string,
    tipo: string,
    latitud: real,
    longitud: real
) with (folder = "Referencia")

// Mapeo JSON para los eventos del simulador. El asistente del Eventstream crea
// uno equivalente; este sirve si configuras la ingesta a mano. Es opcional:
// no hace falta para cargar los CSV.
// La ruta de cada campo va dentro de "Properties", como en la documentación
// actual. La versión anterior de este comando, con "path" y "datatype" junto a
// "column", devolvió BadRequest_InvalidMapping en Fabric.
.create-or-alter table transacciones ingestion json mapping "transacciones_json"
```
[
    {"column": "transaccion_id", "Properties": {"Path": "$.transaccion_id"}},
    {"column": "tarjeta_id",     "Properties": {"Path": "$.tarjeta_id"}},
    {"column": "comercio_id",    "Properties": {"Path": "$.comercio_id"}},
    {"column": "fecha_hora",     "Properties": {"Path": "$.fecha_hora"}},
    {"column": "importe_eur",    "Properties": {"Path": "$.importe_eur"}},
    {"column": "canal",          "Properties": {"Path": "$.canal"}},
    {"column": "pais",           "Properties": {"Path": "$.pais"}},
    {"column": "resultado",      "Properties": {"Path": "$.resultado"}}
]
```

// ----------------------------------------------------------------------------
// Después de cargar los CSV (Get data › Local file, una vez por tabla)
// ----------------------------------------------------------------------------

// Comprobación 1 · Filas: tienen que salir 949, 2400, 294, 24, 3236 y 161462.
// Si una tabla no aparece, está vacía; si tiene el doble, se ha cargado dos veces.
union withsource = tabla transacciones, alertas, comercios, tarjetas, clientes, oficinas
| summarize filas = count() by tabla
| order by tabla asc

// Comprobación 2 · Tipos: cuántas filas tienen valor en las columnas de número
// y de fecha. Tienen que salir, en este orden: 949, 2287 (las empresas no tienen
// edad), 256 (los comercios online no tienen coordenadas), 24, 3236, 161462 y 161462.
// Un 0 significa que la columna se ha cargado vacía.
union
    (alertas       | summarize filas = count(), con_valor = countif(isnotnull(puntuacion_riesgo)) | extend columna = "alertas.puntuacion_riesgo (long)"),
    (clientes      | summarize filas = count(), con_valor = countif(isnotnull(edad))              | extend columna = "clientes.edad (long)"),
    (comercios     | summarize filas = count(), con_valor = countif(isnotnull(latitud))           | extend columna = "comercios.latitud (real)"),
    (oficinas      | summarize filas = count(), con_valor = countif(isnotnull(latitud))           | extend columna = "oficinas.latitud (real)"),
    (tarjetas      | summarize filas = count(), con_valor = countif(isnotnull(limite_eur))        | extend columna = "tarjetas.limite_eur (real)"),
    (transacciones | summarize filas = count(), con_valor = countif(isnotnull(fecha_hora))        | extend columna = "transacciones.fecha_hora (datetime)"),
    (transacciones | summarize filas = count(), con_valor = countif(isnotnull(importe_eur))       | extend columna = "transacciones.importe_eur (real)")
| project columna, filas, con_valor
| order by columna asc

// Perfil de gasto de cada tarjeta, calculado sobre el histórico. Lo usan las
// reglas de importe inusual y país inusual de 02_funciones.kql. Ejecútalo cuando
// el histórico esté cargado y antes de arrancar el simulador.
.set-or-replace perfil_tarjetas with (folder = "Fraude", docstring = "Gasto mediano y última compra en el extranjero de cada tarjeta, según el histórico") <|
    transacciones
    | where resultado == "Aprobada" and not(transaccion_id startswith "TX-RT-")
    | summarize gasto_mediano = percentile(importe_eur, 50),
                operaciones = count(),
                ultima_compra_extranjero = maxif(fecha_hora, pais != "España")
        by tarjeta_id
